#!/usr/bin/env bash
# Stand-in for helm in tests/alert-triage/alertmanager-webhook.sh (the same stand-in as tests/alertmanager-config). The one call that matters,
# `helm upgrade --install prometheus ... --dry-run=server -o json -f <values>`, becomes a
# client-side `helm template` of the same chart and version, wrapped in the JSON shape
# the script reads (.manifest). Everything else is answered without a cluster.
set -euo pipefail
printf 'helm %s\n' "$*" >> "${STUB_LOG:?}"
real="${REAL_HELM:?}"
case "${1:-} ${2:-}" in
  "repo list") printf 'NAME\tURL\ngrafana\tstub\nprometheus-community\tstub\n'; exit 0 ;;
  "repo update"|"repo add") exit 0 ;;   # local client config, not the cluster
esac
if [[ "${1:-}" == "upgrade" && " $* " == *" --dry-run=server "* ]]; then
  version="" namespace="" values=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version) version=$2; shift 2 ;;
      --namespace) namespace=$2; shift 2 ;;
      -f) values=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  cp "$values" "${STUB_VALUES_OUT:?}"
  "$real" template prometheus prometheus \
    --repo https://prometheus-community.github.io/helm-charts \
    --version "$version" --namespace "$namespace" -f "$values" | jq -Rs '{manifest: .}'
  exit 0
fi
if [[ "${1:-}" == "status" ]]; then exit 1; fi
echo "stub helm: refusing: $*" >&2
echo "WRITE helm $*" >> "${STUB_LOG}.writes"
exit 97
