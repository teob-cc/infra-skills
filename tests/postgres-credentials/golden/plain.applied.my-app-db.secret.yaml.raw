apiVersion: v1
kind: Secret
metadata:
  name: my-app-db
  namespace: default
type: Opaque
stringData:
  # PostgreSQL host
  POSTGRES_HOST: postgres-cluster-rw.postgres.svc.cluster.local

  # PostgreSQL port
  POSTGRES_PORT: "5432"

  # PostgreSQL database name
  POSTGRES_DATABASE: my-app

  # PostgreSQL username
  POSTGRES_USERNAME: my-app

  # PostgreSQL password
  POSTGRES_PASSWORD: <PW>
