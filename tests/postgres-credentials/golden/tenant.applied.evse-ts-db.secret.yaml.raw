apiVersion: v1
kind: Secret
metadata:
  name: evse-ts-db
  namespace: symbioen
type: Opaque
stringData:
  # PostgreSQL host (CNPG Pooler pooler-evse-ts)
  POSTGRES_HOST: pooler-evse-ts.postgres.svc.cluster.local

  # PostgreSQL port
  POSTGRES_PORT: "5432"

  # PostgreSQL database name
  POSTGRES_DATABASE: evse-ts

  # PostgreSQL username
  POSTGRES_USERNAME: evse-ts

  # PostgreSQL password
  POSTGRES_PASSWORD: <PW>
