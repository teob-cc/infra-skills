apiVersion: v1
kind: Secret
metadata:
  name: app2-db
  namespace: default
type: Opaque
stringData:
  # PostgreSQL host (CNPG Pooler pooler-app2)
  POSTGRES_HOST: pooler-app2.postgres.svc.cluster.local

  # PostgreSQL port
  POSTGRES_PORT: "5432"

  # PostgreSQL database name
  POSTGRES_DATABASE: app2

  # PostgreSQL username
  POSTGRES_USERNAME: app2

  # PostgreSQL password
  POSTGRES_PASSWORD: <PW>
